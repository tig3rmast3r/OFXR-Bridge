if(ASYNC_RESET)
  set(ENV{XRFG_TEST_AFW_ASYNC_RESET} 1)
endif()
foreach(argument TEST_EXE PROVIDER DESTINATION)
    if(NOT DEFINED ${argument})
        message(FATAL_ERROR "Missing ${argument}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${DESTINATION}")
if(NOT DEFINED TITLE)
    set(TITLE KCD2)
endif()
if(TITLE STREQUAL "INDY")
    set(EXE indiana-quality.exe)
elseif(TITLE STREQUAL "KCD2")
    set(EXE kcd-quality.exe)
elseif(TITLE STREQUAL "GTAVE")
    set(EXE gta-quality.exe)
elseif(TITLE STREQUAL "DS2023")
    set(EXE dead-space-quality.exe)
else()
    message(FATAL_ERROR "Unknown isolated quality title")
endif()
file(COPY_FILE "${TEST_EXE}" "${DESTINATION}/${EXE}" ONLY_IF_DIFFERENT)
file(COPY_FILE "${PROVIDER}" "${DESTINATION}/PDAFWPlugin.dll" ONLY_IF_DIFFERENT)
file(WRITE "${DESTINATION}/RealVR.ini" "[${TITLE}]\nWorldScale=1.0\n")
if(NOT DEFINED SHADING_RATE)
    set(SHADING_RATE 0)
endif()
set(EXTRA_ARGS)
if(INTERLEAVED)
    list(APPEND EXTRA_ARGS interleaved)
endif()
set(TEST_ENV)
if(EPOCH_TRANSITION)
    set(TEST_ENV "${CMAKE_COMMAND}" -E env XRFG_TEST_AFW_EPOCH_TRANSITION=1)
endif()
if(GEOMETRY_TRANSITION)
    set(TEST_ENV "${CMAKE_COMMAND}" -E env XRFG_TEST_AFW_GEOMETRY_TRANSITION=1)
endif()
if(PUBLICATION_GAP)
    set(TEST_ENV "${CMAKE_COMMAND}" -E env "XRFG_TEST_AFW_PUBLICATION_GAP=${PUBLICATION_GAP}")
endif()
execute_process(COMMAND ${TEST_ENV} "${DESTINATION}/${EXE}" "${DESTINATION}/PDAFWPlugin.dll" "${SHADING_RATE}" ${EXTRA_ARGS}
    WORKING_DIRECTORY "${DESTINATION}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 80)
message("${output}${error}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Actual KCD full shader/provider quality regression failed (${result})")
endif()
