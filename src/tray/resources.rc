#include <windows.h>
#include "resource.h"

IDI_OFXR_DISARMED ICON "../../OFXR_disarmed.ico"
IDI_OFXR_ARMED ICON "../../OFXR_armed.ico"

IDD_KEYBINDS DIALOGEX 0, 0, 364, 264
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OFXR-BRIDGE 0.3.3 (v984) - Configure keybinds"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Click Change, then press a key or combination.", -1, 12, 12, 340, 14
    LTEXT "Open interface", -1, 12, 40, 110, 12
    LTEXT "", 1100, 129, 40, 104, 12
    CONTROL "", 1110, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 126, 36, 108, 18
    PUSHBUTTON "Change", 1120, 243, 36, 60, 18
    PUSHBUTTON "Clear", 1130, 310, 36, 42, 18
    LTEXT "Toggle NR", -1, 12, 65, 110, 12
    LTEXT "", 1101, 129, 65, 104, 12
    CONTROL "", 1111, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 126, 61, 108, 18
    PUSHBUTTON "Change", 1121, 243, 61, 60, 18
    PUSHBUTTON "Clear", 1131, 310, 61, 42, 18
    LTEXT "Toggle framegen", -1, 12, 90, 110, 12
    LTEXT "", 1102, 129, 90, 104, 12
    CONTROL "", 1112, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 126, 86, 108, 18
    PUSHBUTTON "Change", 1122, 243, 86, 60, 18
    PUSHBUTTON "Clear", 1132, 310, 86, 42, 18
    LTEXT "Enable logging", -1, 12, 115, 110, 12
    LTEXT "", 1103, 129, 115, 104, 12
    CONTROL "", 1113, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 126, 111, 108, 18
    PUSHBUTTON "Change", 1123, 243, 111, 60, 18
    PUSHBUTTON "Clear", 1133, 310, 111, 42, 18
    LTEXT "Dump (debug)", -1, 12, 140, 110, 12
    LTEXT "", 1104, 129, 140, 104, 12
    CONTROL "", 1114, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 126, 136, 108, 18
    PUSHBUTTON "Change", 1124, 243, 136, 60, 18
    PUSHBUTTON "Clear", 1134, 310, 136, 42, 18
    LTEXT "Toggle FPS counter", -1, 12, 165, 110, 12
    LTEXT "", 1105, 129, 165, 104, 12
    CONTROL "", 1115, "msctls_hotkey32", WS_TABSTOP | WS_BORDER, 126, 161, 108, 18
    PUSHBUTTON "Change", 1125, 243, 161, 60, 18
    PUSHBUTTON "Clear", 1135, 310, 161, 42, 18
    LTEXT "Dump requires logging. Shortcuts are paused while configuring.", -1, 12, 189, 340, 14
    LTEXT "", IDC_KEYBIND_STATUS, 12, 206, 340, 25
    PUSHBUTTON "Restore defaults", IDC_KEYBIND_DEFAULTS, 12, 238, 88, 18
    DEFPUSHBUTTON "OK", IDOK, 241, 238, 52, 18
    PUSHBUTTON "Cancel", IDCANCEL, 300, 238, 52, 18
END

IDD_RIFE_INSTALL DIALOGEX 0, 0, 388, 244
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Install RIFE"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", IDC_RIFE_REASON, 12, 12, 364, 28
    GROUPBOX "Graphics card", -1, 12, 44, 364, 58
    CONTROL "NVIDIA (CUDA / TensorRT)", IDC_RIFE_NVIDIA, "Button", BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP, 24, 59, 338, 16
    CONTROL "AMD Radeon - Vulkan (experimental)", IDC_RIFE_AMD, "Button", BS_AUTORADIOBUTTON | WS_DISABLED, 24, 79, 338, 16
    LTEXT "Install location (AppData, shared by all OFXR versions):", -1, 12, 112, 364, 13
    EDITTEXT IDC_RIFE_DESTINATION, 12, 128, 364, 28, ES_READONLY | ES_MULTILINE | ES_AUTOHSCROLL
    LTEXT "About 8 GB installed. Keep at least 14 GB free during installation. TensorRT caches can grow afterwards.", IDC_RIFE_SPACE, 12, 166, 364, 27
    LTEXT "A PowerShell window will show progress. No further input is required.", IDC_RIFE_PROGRESS, 12, 199, 364, 14
    DEFPUSHBUTTON "Install", IDOK, 258, 218, 56, 18
    PUSHBUTTON "Cancel", IDCANCEL, 320, 218, 56, 18
END

1 VERSIONINFO
FILEVERSION 0,3,3,984
PRODUCTVERSION 0,3,3,984
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "OFXR-BRIDGE 0.3.3 (v984)\0"
   VALUE "ProductName", "OFXR-BRIDGE\0"
   VALUE "FileVersion", "0.3.3 (v984)\0"
   VALUE "ProductVersion", "0.3.3 (v984)\0"
   VALUE "OriginalFilename", "OFXRBridgeTray.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
